# SmartLearn Server Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI (Replace placeholders with actual credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smartlearn?retryWrites=true&w=majority

# JWT Authentication (minimum 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Rate Limiting Configuration (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Initial Admin Account Provisioning (optional for scripts/createAdmin.js)
ADMIN_EMAIL=admin@smartlearn.org
ADMIN_PASSWORD=your_initial_admin_password_min_8_chars

# Password Reset & Email Configuration (Task 4)
# To send real emails, provide your SMTP credentials below (e.g. Gmail App Password, SendGrid, Amazon SES, Mailgun)
# If left empty, the application safely operates in preview/mock mode without failing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=SmartLearn Support <support@smartlearn.org>
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_EXPIRE_MINUTES=15

